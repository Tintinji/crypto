# Paper is the default. Live requires BOTH of these plus CLI flag.
# LIVE_TRADING=1
# Then run: factorlib live-order --i-understand-live

# Kill switch (also honored if a file named KILL exists in CWD or repo root)
# KILL_SWITCH=1

# ccxt credentials — NEVER commit real keys
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
EXCHANGE_PASSWORD=
